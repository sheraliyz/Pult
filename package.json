{
  "name": "pult",
  "productName": "Pult",
  "version": "1.1.0",
  "description": "Server boshqaruvi: terminal va fayllar",
  "author": "Sherali Istamov",
  "license": "MIT",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "node dev/mock-server.js",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "uz.pult.app",
    "productName": "Pult",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@fontsource*/scss/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Pult"
    },
    "portable": {
      "artifactName": "Pult-portable.exe"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
